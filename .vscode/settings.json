{
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": ["source.fixAll.eslint"],
    "eslint.validate": ["javascript", "javascriptreact", "typescript", "vue"],
    "workbench.colorCustomizations": {
        "editorBracketHighlight.foreground1": "#5caeef",
        "editorBracketHighlight.foreground2": "#dfb976",
        "editorBracketHighlight.foreground3": "#c172d9",
        "editorBracketHighlight.foreground4": "#4fb1bc",
        "editorBracketHighlight.foreground5": "#97c26c",
        "editorBracketHighlight.foreground6": "#abb2c0",
        "editorBracketHighlight.unexpectedBracket.foreground": "#db6165",
        "iLoveWorkSpaceColors": true,
        "iLoveWorkSpaceRandom": false,
        "activityBar.activeBackground": "#f4fe91",
        "activityBar.background": "#f4fe91",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#02acbe",
        "activityBarBadge.foreground": "#e7e7e7",
        "commandCenter.border": "#15202b99",
        "sash.hoverBorder": "#f4fe91",
        "statusBarItem.hoverBackground": "#eafc2d",
        "statusBarItem.remoteBackground": "#effd5f",
        "statusBarItem.remoteForeground": "#15202b",
        "titleBar.activeBackground": "#effd5f",
        "titleBar.activeForeground": "#15202b",
        "titleBar.inactiveBackground": "#effd5f99",
        "titleBar.inactiveForeground": "#15202b99"
    },
    "peacock.color": "#EFFD5F"
}
