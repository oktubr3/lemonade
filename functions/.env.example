# Firebase Functions Environment Variables
# Copy this file to .env and fill in the values.
# .env is git-ignored — never commit real secrets.

# Comma-separated list of admin email addresses (no spaces).
# Admins can run migrations, manage users, view audit logs, etc.
ADMIN_EMAILS=admin@example.com

# ─────────────────────────────────────────────────────────────────────────────
# The following values are NOT placed here. They live in Firebase Secret Manager
# (firebase functions:secrets:set NAME). Listed for reference / self-host docs:
#
#   ENCRYPTION_KEY          AES-256 key for server-side password vault encryption.
#                           Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
#   POLAR_ACCESS_TOKEN      Polar.sh API token (only if you enable hosted billing)
#   POLAR_PRODUCT_ID        Polar product ID
#   POLAR_WEBHOOK_SECRET    Polar webhook signing secret
#
#   HIBP_API_KEY            Have I Been Pwned API key (optional)
#   GOOGLE_AI_API_KEY       Google Generative AI key (optional, for AI password insights)
#
# Set each with:
#   firebase functions:secrets:set SECRET_NAME
# ─────────────────────────────────────────────────────────────────────────────
