/package-lock.json

# local .env files
.env.local*
.env
.env.development.local
.env.production.local
.env.local
functions/.env
functions/.env.local
firebase-debug.log

# Playwright MCP
.playwright-mcp/

# Google Cloud SDK
google-cloud-sdk/
google-cloud-cli-*.tar.gz

# Extension build artifacts
lemonade-chrome-extension-v*.zip
lemonade-firefox-extension-v*.zip
.gemini_security/

# Capacitor Android build artifacts (large generated files, ~150MB)
src-capacitor/android/app/src/main/assets/public/
src-capacitor/android/.gradle/
src-capacitor/android/build/
src-capacitor/android/app/build/

# Defense-in-depth: Firebase service accounts must never be committed
serviceAccount*.json
*-firebase-adminsdk-*.json
*-service-account-*.json
**/firebase-service-account.json
