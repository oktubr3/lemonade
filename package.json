{
    "name": "pass-manager",
    "version": "2.2.23",
    "packageManager": "pnpm@9.15.9",
    "description": "A very simple and secure password manager.",
    "productName": "Lemonade Password Manager",
    "author": "oktubr3 <mauroh@gmail.com>",
    "private": true,
    "scripts": {
        "lint": "eslint .",
        "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:rules": "npx -y firebase-tools@13 emulators:exec --only firestore --project passmanager-test \"node test/firestore-rules.test.mjs\"",
        "dev": "quasar dev --mode pwa",
        "build": "npm run version:auto && quasar build --mode pwa",
        "build:manual": "quasar build --mode pwa",
        "version:auto": "bash version.sh patch",
        "version:minor": "bash version.sh minor",
        "version:major": "bash version.sh major"
    },
    "dependencies": {
        "@quasar/extras": "^1.18.0",
        "@simplewebauthn/browser": "^14.0.0",
        "firebase": "^12.19.0",
        "pinia": "^4.0.3",
        "qr-scanner": "^1.4.2",
        "quasar": "^2.34.0",
        "vue": "^3.5.43",
        "vue-i18n": "^11.4.10",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@firebase/rules-unit-testing": "^5.0.0",
        "@intlify/unplugin-vue-i18n": "^11.2.5",
        "@quasar/app-vite": "^3.10.1",
        "autoprefixer": "^10.6.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.12.0",
        "postcss": "^8.5.28",
        "prettier": "^3.9.9",
        "vite": "^8.3.2",
        "vitest": "^5.0.3",
        "vue-eslint-parser": "^10.3.0"
    },
    "engines": {
        "node": "^22.22.0 || ^24 || ^26 || ^28 || ^30",
        "npm": ">= 6.13.4",
        "yarn": ">= 1.21.1"
    },
    "pnpm": {
        "overrides": {
            "serialize-javascript": ">=7.0.5",
            "immutable": ">=5.1.8",
            "esbuild": ">=0.28.1"
        }
    }
}
